{
  "balance_strategy": "round-robin",
  "default_route": {
    "action": "proxy",
    "upstreams": ["vpn-default"]
  },
  "upstreams": [
    {
      "name": "vpn-default",
      "url": "http://127.0.0.1:6578",
      "weight": 1,
      "enabled": true
    },
    {
      "name": "residential-01",
      "url": "socks5://user:pass@residential-host-1:1080",
      "weight": 1,
      "enabled": true
    },
    {
      "name": "residential-02",
      "url": "http://user:pass@residential-host-2:8080",
      "weight": 2,
      "enabled": true
    }
  ],
  "rules": [
    {
      "domain": "openai.com",
      "action": "proxy",
      "upstreams": ["residential-01", "residential-02"]
    },
    {
      "domain": "anthropic.com",
      "action": "proxy",
      "upstreams": ["residential-01", "residential-02"]
    },
    {
      "domain": "claude.ai",
      "action": "proxy",
      "upstreams": ["residential-01", "residential-02"]
    }
  ]
}
